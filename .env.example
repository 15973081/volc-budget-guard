APP_ENV=dev
DATABASE_URL=sqlite:///./budget_guard.db
BUDGET_CONFIG_PATH=./config/budgets.yaml
POLL_INTERVAL_MINUTES=60
DRY_RUN=true
BILLING_PROVIDER=mock
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_BILLING_ENDPOINT=https://billing.volcengineapi.com
VOLC_REGION=cn-north-1
LIMITER_PROVIDER=webhook
LIMITER_WEBHOOK_URL=http://localhost:9000/internal/projects/{project_id}/access
LIMITER_WEBHOOK_TOKEN=change-me
ALERT_WEBHOOK_URL=
CONFIG_API_TOKEN=replace-with-a-long-random-token
